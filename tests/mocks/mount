#!/bin/sh
set -eu
STATE=${CIFSBAK_MOCK_STATE:?}
if [ "${1:-}" = "-p" ]; then
    cat "$STATE/mount-p.txt"
    exit 0
fi
if [ $# -eq 0 ]; then
    if [ -f "$STATE/smbfs-mountpoint" ]; then
        mp=$(cat "$STATE/smbfs-mountpoint")
        printf '//backup@NAS/share on %s (smbfs)\n' "$mp"
    fi
    exit 0
fi
exec /bin/mount "$@"
