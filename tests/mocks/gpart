#!/bin/sh
set -eu
STATE=${CIFSBAK_MOCK_STATE:?}
printf '%s\n' "$*" >>"$STATE/gpart.log"
cmd=${1:?}
shift
case $cmd in
    list)
        cat "$STATE/gpart-list.txt"
        ;;
    backup)
        disk=$1
        [ -f "$STATE/gpart-backup.$disk" ] || {
            printf 'gpart mock: нет схемы %s\n' "$disk" >&2
            exit 1
        }
        cat "$STATE/gpart-backup.$disk"
        ;;
    *)
        printf 'gpart mock: %s\n' "$cmd" >&2
        exit 1
        ;;
esac
